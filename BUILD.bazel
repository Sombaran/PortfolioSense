load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_import", "cc_library", "cc_test")

exports_files([
    "googletest_bazel9.patch",
    "nlohmann_json_bazel9.patch",
])

filegroup(
    name = "vcpkg_libcurl_file",
    srcs = glob(["build_support/vcpkg_curl/lib/libcurl.lib"]),
    visibility = ["//visibility:private"],
)

cc_import(
    name = "vcpkg_libcurl",
    hdrs = glob(["build_support/vcpkg_curl/include/curl/**"]),
    interface_library = ":vcpkg_libcurl_file",
    includes = ["build_support/vcpkg_curl/include"],
    system_provided = True,
    visibility = ["//visibility:private"],
)

_PLATFORM_ADAPTER = select({
    "@platforms//os:windows": ["adapters/windows/PlatformAdapter.cpp"],
    "@platforms//os:osx": ["adapters/macos/PlatformAdapter.cpp"],
    "//conditions:default": ["adapters/linux/PlatformAdapter.cpp"],
})

_CXX_COPTS = select({
    "@platforms//os:windows": [
        "/std:c++17",
        "/W4",
        "/utf-8",
        "/permissive-",
    ],
    "//conditions:default": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
    ],
})

_PLATFORM_LINKOPTS = select({
    "@platforms//os:windows": [
        "ws2_32.lib",
        "bcrypt.lib",
    ],
    "//conditions:default": [
        "-lcurl",
        "-lpthread",
    ],
})

_PLATFORM_DEFINES = select({
    "@platforms//os:windows": [
        "_CRT_SECURE_NO_WARNINGS",
        "NOMINMAX",
        "WIN32_LEAN_AND_MEAN",
    ],
    "//conditions:default": [],
})

_PROJECT_DEFINES = _PLATFORM_DEFINES + [
    "PORTFOLIO_HEALTH_VERSION=\\\"2.0.77\\\"",
]

cc_library(
    name = "portfolio_health_core",
    srcs = [
        "src/HttpClient.cpp",
        "src/UpstoxClient.cpp",
        "src/StreamingClient.cpp",
        "src/WebServer.cpp",
        "src/PortfolioHealth.cpp",
        "src/PortfolioLoader.cpp",
        "src/TechnicalIndicators.cpp",
        "src/MLModels.cpp",
        "src/SignalGenerator.cpp",
        "src/OrdersAPI.cpp",
        "src/NotificationService.cpp",
        "src/SecureUtils.cpp",
        "src/TaskScheduler.cpp",
    ] + _PLATFORM_ADAPTER,
    hdrs = glob(["include/*.hpp", "adapters/include/*.hpp"]),
    includes = ["include", "adapters/include"],
    deps = ["@nlohmann_json//:json"] + select({
        "@platforms//os:windows": [":vcpkg_libcurl"],
        "//conditions:default": [],
    }),
    copts = _CXX_COPTS,
    defines = _PROJECT_DEFINES,
    linkopts = _PLATFORM_LINKOPTS,
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "portfolio_health",
    srcs = ["src/main.cpp"],
    deps = [":portfolio_health_core"],
    copts = _CXX_COPTS,
    defines = _PROJECT_DEFINES,
)

cc_test(
    name = "portfolio_health_tests",
    srcs = ["tests/cpp/test_security.cpp"],
    deps = [
        ":portfolio_health_core",
        "@googletest//:gtest_main",
    ],
    copts = _CXX_COPTS,
    defines = _PLATFORM_DEFINES,
)
